# Application
APP_NAME=ai-humanizer
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# Privacy
STORE_USER_TEXT=false

# Model Provider (transformers, ollama, vllm, triton)
MODEL_PROVIDER=transformers

# Device (auto, cuda, cpu, mps)
MODEL_DEVICE=auto

# Humanization Model
HUMANIZER_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
HUMANIZER_MODEL_REVISION=main
HUMANIZER_MAX_NEW_TOKENS=2048
HUMANIZER_TEMPERATURE=0.7
HUMANIZER_TOP_P=0.9
HUMANIZER_REPETITION_PENALTY=1.1

# Quantization (none, 8bit, 4bit) - for transformers provider
HUMANIZER_QUANTIZATION=4bit

# Semantic Validation
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_SIMILARITY_THRESHOLD=0.85
MAX_REWRITE_ATTEMPTS=2

# Input Limits
MAX_INPUT_CHARACTERS=20000
MAX_INPUT_WORDS=3000

# NLP Analysis
SPACY_MODEL=en_core_web_sm
USE_STOPWORDS_IN_METRICS=true

# Naturalness Score Weights (must sum to 1.0)
WEIGHT_SENTENCE_VARIATION=0.20
WEIGHT_LEXICAL_DIVERSITY=0.20
WEIGHT_REPETITION=0.15
WEIGHT_TEMPLATE_DENSITY=0.15
WEIGHT_PASSIVE_VOICE=0.10
WEIGHT_READABILITY=0.10
WEIGHT_SEMANTIC_COHERENCE=0.10

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request ID Header
REQUEST_ID_HEADER=X-Request-ID